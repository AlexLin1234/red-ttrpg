; Cyberpunk RED Stream GM Viewer
config_version=5

[application]

config/name="Cyberpunk RED Stream GM Viewer"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

undo={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":90,"ctrl_pressed":true)]
}
redo={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":90,"ctrl_pressed":true,"shift_pressed":true)]
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.003, 0.005, 0.015, 1)
