; Cyberpunk RED stream viewer.
;
; A display-only Godot client for the local GM service. It never rolls dice and
; never edits state: it draws whatever snapshot the service broadcasts.

config_version=5

[application]

config/name="Cyberpunk RED Viewer"
config/description="OBS-capture viewer for the local Cyberpunk RED GM service."
run/main_scene="res://scenes/viewer.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/per_pixel_transparency/allowed=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
