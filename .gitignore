# Godot
.godot/
export_presets.cfg
*.translation

# Book-derived data stays local. No rulebook, in any container format, is ever
# published from this repository.
*.pdf
*.epub
*.mobi
*.azw
*.azw3
*.cbz
*.cbr
!docs/mockups/*.pdf

# data/ exists only to hold private, book-derived runtime data: extracted text,
# page scans, table CSVs, the rules index and the rulebook item catalog. Exclude
# the whole tree by default, so a new extraction artifact is never published by
# accident, and re-include just the two mount points Git has to carry. Add a
# negation here only for a file that is genuinely ours to ship.
data/*
!data/.gdignore
!data/maps/
data/maps/*
!data/maps/.gitkeep

# catalog/ ships our own homebrew placeholders and is tracked. A rulebook-derived
# catalog written beside them is not ours to publish.
catalog/items_local.json

# Build output
build/
export/
release/
dist/
.pytest_cache/

# The rulebook assistant keeps imported books, extracted text, indexes, question
# history and the API key in per-user application data and the OS credential
# vault — never in the repository. These are only here in case a developer
# points REDLINE_ASSISTANT_HOME at the checkout.
assistant/books/
assistant/index/
assistant/history/
assistant/library.json
assistant/settings.json

tmp/
.gstack/
.DS_Store
__pycache__/
*.py[cod]

# Legacy sidecar worktrees were removed in the single-project rebuild.
/cprtool/
/viewer/

# Rendered screenshots are build output.
.shots/

# Private desktop captures stay local. Their Godot import metadata does too.
/Screenshot*.png
/Screenshot*.png.import
