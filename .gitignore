# Godot
.godot/
export_presets.cfg
*.translation

# Book-derived data stays local.
*.pdf
!docs/mockups/*.pdf
# Private source and extracted map assets (keep the mount point in Git).
data/maps/*.png
data/maps/*.jpg
data/maps/*.jpeg
data/maps/*.pdf
!data/maps/.gitkeep
!data/.gdignore
# Extracted rulebook text, tables and page scans.
data/chunks.jsonl
data/rules.db
data/tables/
# Item catalog extracted from a user-owned rulebook by scripts/extract_items.py.
data/items_local.json

# Build output
build/
export/
release/

tmp/
.gstack/
.DS_Store
__pycache__/
*.py[cod]

# Legacy sidecar worktrees were removed in the single-project rebuild.
/cprtool/
/viewer/

# Rendered screenshots are build output.
.shots/
