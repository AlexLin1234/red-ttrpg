# Godot
.godot/
*.translation
# export_presets.cfg is normally ignored, because it usually carries machine
# paths and signing configuration. This one carries neither: it exists so a
# release is the same command with the same contents on every machine, and so
# the data/*.json the app reads at runtime actually reach an exported build.

# Book-derived data stays local.
*.pdf
!docs/mockups/*.pdf
# Private source and extracted map assets (keep the mount point in Git).
data/maps/*.png
data/maps/*.jpg
data/maps/*.jpeg
data/maps/*.pdf
!data/maps/.gitkeep
!data/.gdignore
# Extracted rulebook text, tables and page scans.
data/chunks.jsonl
data/rules.db
data/tables/
# Item catalog extracted from a user-owned rulebook by scripts/extract_items.py.
data/items_local.json

# Build output
build/
export/
release/
dist/
.pytest_cache/

# The rulebook assistant keeps imported books, extracted text, indexes, question
# history and the API key in per-user application data and the OS credential
# vault — never in the repository. These are only here in case a developer
# points REDLINE_ASSISTANT_HOME at the checkout.
assistant/books/
assistant/index/
assistant/history/
assistant/library.json

tmp/
.gstack/
.DS_Store
__pycache__/
*.py[cod]

# Legacy sidecar worktrees were removed in the single-project rebuild.
/cprtool/
/viewer/

# Rendered screenshots are build output.
.shots/

# Private desktop captures stay local. Their Godot import metadata does too.
/Screenshot*.png
/Screenshot*.png.import
